<Project Sdk="Microsoft.NET.Sdk">
  <!-- Data loading, the tree learners (written from scratch), the ML.NET check, experiments and the demo build. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <Optimize>true</Optimize>
    <WarnOn>3390;$(WarnOn)</WarnOn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Csv.fs" />
    <Compile Include="Json.fs" />
    <Compile Include="Data.fs" />
    <Compile Include="Binning.fs" />
    <Compile Include="TreeBuilder.fs" />
    <Compile Include="Learners.fs" />
    <Compile Include="Metrics.fs" />
    <Compile Include="Baselines.fs" />
    <Compile Include="MlNetCheck.fs" />
    <Compile Include="Experiments.fs" />
    <Compile Include="Demo.fs" />
    <Compile Include="Page.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Core/Gavel.Core.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.ML" Version="3.0.1" />
    <PackageReference Include="Microsoft.ML.FastTree" Version="3.0.1" />
    <PackageReference Include="Microsoft.ML.LightGbm" Version="3.0.1" />
  </ItemGroup>
</Project>
